---
import Base from '../layouts/Base.astro';
import AffiliateLink from '../components/AffiliateLink.astro';
import { profile, links, socials } from '../data/site';
---
<Base title="Malory">
  <section class="profile">
    <div class="avatar">
      {profile.avatar
        ? <img src={profile.avatar} alt={profile.name} />
        : <span aria-hidden="true">{profile.name[0]}</span>}
    </div>
    <h1>{profile.name}</h1>
    <p>{profile.tagline}</p>
  </section>

  <nav class="links" id-"picks" aria-label="Recommended links">
    {links.map((l, i) => (
      <AffiliateLink href={l.url} class={i === 0 ? 'link featured' : 'link'}>
        <b>{l.label}</b>
        <small>{l.note}</small>
      </AffiliateLink>
    ))}
  </nav>

  <p class="note">Some of these are affiliate links. <a href="/disclosure">Here is what that means</a>.</p>

  {socials.length > 0 && (
    <div class="socials">
      {socials.map((s) => <a href={s.url} rel="noopener" target="_blank">{s.label}</a>)}
    </div>
  )}
</Base>
