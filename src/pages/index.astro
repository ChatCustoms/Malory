---
import Base from '../layouts/Base.astro';
import AffiliateLink from '../components/AffiliateLink.astro';
import { profile, shop, sections, socials } from '../data/site';
const shopLive = shop.url && shop.url !== '#';
---
<Base title="Malory">
  <section class="profile">
    <div class="avatar">
      {profile.avatar
        ? <img src={profile.avatar} alt={profile.name} />
        : <span aria-hidden="true">{profile.name[0]}</span>}
    </div>
    <h1>{profile.name}</h1>
    <p>{profile.tagline}</p>
  </section>

  <div class="links" id="picks">
    <a href={shop.url} class="link featured" target={shopLive ? '_blank' : undefined} rel="noopener">
      <b>{shop.label}</b>
      <small>{shop.note}</small>
    </a>
  </div>

  <p class="note">Some links below are affiliate links. As an Amazon Associate, Malory earns from qualifying purchases. <a href="/disclosure">Details</a>.</p>

  {sections.map((s) => (
    <section class="group">
      <h2>{s.title}</h2>
      <nav class="links" aria-label={s.title}>
        {s.items.map((l) => (
          <AffiliateLink href={l.url} class="link">
            <b>{l.label}</b>
            <small>{l.note}</small>
          </AffiliateLink>
        ))}
      </nav>
    </section>
  ))}

  {socials.length > 0 && (
    <div class="socials">
      {socials.map((s) => <a href={s.url} rel="noopener" target="_blank">{s.label}</a>)}
    </div>
  )}
</Base>
